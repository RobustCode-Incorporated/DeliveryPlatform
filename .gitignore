# OS files
.DS_Store
Thumbs.db

# Stray git artifacts that should never be committed
FETCH_HEAD

# Secrets / local environment (templates ending in .example are allowed)
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.jks

# Dependencies and build outputs
node_modules/
dist/
build/
target/
coverage/
.expo/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE folders (shared VS Code recommendations/settings stay tracked)
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
