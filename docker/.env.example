# Local development only. Copy to docker/.env before starting the stack:
#   cp docker/.env.example docker/.env
# docker/.env is git-ignored. Never put production/Neon credentials here.
# The values below are the historical local defaults expected by the backend's
# local (MySQL) profile; change them if you also change the backend config.
MYSQL_DATABASE=delivery_db
MYSQL_USER=delivery_user
MYSQL_PASSWORD=delivery_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306
